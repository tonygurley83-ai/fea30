const GoogleStrategy =
  require(
    "passport-google-oauth20"
  ).Strategy;

const AuthService =
  require(
    "../services/AuthService"
  );

module.exports =
  passport => {

    passport.use(

      new GoogleStrategy(

        {

          clientID:
            process.env
              .GOOGLE_CLIENT_ID,

          clientSecret:
            process.env
              .GOOGLE_CLIENT_SECRET,

          callbackURL:
            process.env
              .GOOGLE_CALLBACK_URL

        },

        async (

          accessToken,

          refreshToken,

          profile,

          done

        ) => {

          try {

            const user =
              await AuthService
                .loginGoogle({

                  providerId:
                    profile.id,

                  email:
                    profile.emails?.[0]
                      ?.value,

                  displayName:
                    profile.displayName

                });

            return done(
              null,
              user
            );

          }
          catch (error) {

            return done(
              error
            );

          }

        }

      )

    );

  };
