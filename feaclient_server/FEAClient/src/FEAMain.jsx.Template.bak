import React, { useEffect, useState } from "react";
import AuthService from "../FEAClientApiService/services/AuthService";
import mirror from "../src/MirrorClient";
import ProjectSidebar from "../FEAClient/src/Projects/ProjectSidebar";

function FEAMain() {
  const [user, setUser] = useState(null);
  const [projects, setProjects] = useState([]);
  const [selectedProjectId, setSelectedProjectId] = useState(null);
  
  // Storage for all canvas types: { [projectId]: [], __personal__: [], __shared__: [] }
  const [canvases, setCanvases] = useState({
    __personal__: [],
    __shared__: []
  });
  const [selectedCanvasId, setSelectedCanvasId] = useState(null);

  const currentUser = AuthService.getUser();
  const userId = currentUser?.id;

  useEffect(() => {
    if (userId) {
      loadUser();
      loadProjects();
      loadPersonalCanvases();
      loadSharedCanvases();
    }
  }, [userId]);

  async function loadUser() {
    try {
      const response = await fetch(`/auth/user/${userId}`);
      const data = await response.json();
      setUser(data);
    } catch (error) {
      console.error("User Load Failed", error);
    }
  }

  async function loadProjects() {
    try {
      const response = await fetch(`/auth/user/${userId}/projects`);
      const data = await response.json();
      setProjects(data);

      if (data.length > 0) {
        selectProject(data[0]);
      }
    } catch (error) {
      console.error("Project Load Failed", error);
    }
  }

  async function loadCanvases(projectId) {
    try {
      const response = await fetch(`/api/canvases/project/${projectId}`);
      const data = await response.json();
      setCanvases((prev) => ({ ...prev, [projectId]: data }));
    } catch (error) {
      console.error("Project Canvases Load Failed", error);
    }
  }

  async function loadPersonalCanvases() {
    try {
      const response = await fetch(`/api/canvases/personal?userId=${userId}`);
      const data = await response.json();
      setCanvases((prev) => ({ ...prev, __personal__: data }));
    } catch (error) {
      console.error("Personal Canvases Load Failed", error);
    }
  }

  async function loadSharedCanvases() {
    try {
      const response = await fetch(`/api/canvases/shared?userId=${userId}`);
      const data = await response.json();
      setCanvases((prev) => ({ ...prev, __shared__: data }));
    } catch (error) {
      console.error("Shared Canvases Load Failed", error);
    }
  }

  function selectProject(project) {
    setSelectedProjectId(project.id);
    mirror.publish({ type: "PROJECT_CHANGED", project });
    loadCanvases(project.id);
  }

  function selectCanvas(canvas) {
    setSelectedCanvasId(canvas.id);
    mirror.publish({ type: "CANVAS_CHANGED", canvas });
  }

  // --- PROJECT CRUD ---

  async function createProject() {
    const name = window.prompt("Enter new project name:", "New Project");
    if (!name || !name.trim()) return;

    try {
      const response = await fetch(`/auth/user/${userId}/projects`, {
        method: "POST",
        headers: { "Content-Type": "application/json" },
        body: JSON.stringify({ name: name.trim() })
      });
      const project = await response.json();
      setProjects((prev) => [...prev, project]);
      selectProject(project);
    } catch (error) {
      console.error("Project Create Failed", error);
    }
  }

  async function renameProject(projectId, currentName) {
    const newName = window.prompt("Enter new name for project:", currentName);
    if (!newName || !newName.trim() || newName === currentName) return;

    try {
      const response = await fetch(`/auth/user/${userId}/projects/${projectId}`, {
        method: "PUT",
        headers: { "Content-Type": "application/json" },
        body: JSON.stringify({ name: newName.trim() })
      });
      const updatedProject = await response.json();

      setProjects((prev) =>
        prev.map((p) => (p.id === projectId ? updatedProject : p))
      );

      if (selectedProjectId === projectId) {
        mirror.publish({ type: "PROJECT_CHANGED", project: updatedProject });
      }
    } catch (error) {
      console.error("Project Rename Failed", error);
    }
  }

  async function deleteProject(projectId) {
    if (!window.confirm("Delete this project and its canvases?")) return;

    try {
      await fetch(`/auth/user/${userId}/projects/${projectId}`, {
        method: "DELETE"
      });

      const updatedProjects = projects.filter((p) => p.id !== projectId);
      setProjects(updatedProjects);

      setCanvases((prev) => {
        const next = { ...prev };
        delete next[projectId];
        return next;
      });

      if (selectedProjectId === projectId) {
        if (updatedProjects.length > 0) {
          selectProject(updatedProjects[0]);
        } else {
          setSelectedProjectId(null);
          setSelectedCanvasId(null);
          mirror.publish({ type: "PROJECT_CHANGED", project: null });
        }
      }
    } catch (error) {
      console.error("Project Delete Failed", error);
    }
  }

  // --- CANVAS CRUD (Supports Project, __personal__, and __shared__) ---

  async function createCanvas(targetKey) {
    const name = window.prompt("Enter new canvas name:", "New Canvas");
    if (!name || !name.trim()) return;

    try {
      const response = await fetch(`/api/canvases`, {
        method: "POST",
        headers: { "Content-Type": "application/json" },
        body: JSON.stringify({
          userId,
          projectId: targetKey, // Pass project ID or "__personal__"/"__shared__"
          name: name.trim(),
          canvasData: {}
        })
      });
      const canvas = await response.json();

      setCanvases((prev) => ({
        ...prev,
        [targetKey]: [...(prev[targetKey] || []), canvas]
      }));

      selectCanvas(canvas);
    } catch (error) {
      console.error("Canvas Create Failed", error);
    }
  }

  async function renameCanvas(groupKey, canvasId, currentName) {
    const newName = window.prompt("Enter new canvas name:", currentName);
    if (!newName || !newName.trim() || newName === currentName) return;

    try {
      const response = await fetch(`/api/canvases/${canvasId}`, {
        method: "PUT",
        headers: { "Content-Type": "application/json" },
        body: JSON.stringify({ userId, name: newName.trim() })
      });
      const updatedCanvas = await response.json();

      setCanvases((prev) => ({
        ...prev,
        [groupKey]: (prev[groupKey] || []).map((c) =>
          c.id === canvasId ? updatedCanvas : c
        )
      }));

      if (selectedCanvasId === canvasId) {
        mirror.publish({ type: "CANVAS_CHANGED", canvas: updatedCanvas });
      }
    } catch (error) {
      console.error("Canvas Rename Failed", error);
    }
  }

  async function deleteCanvas(groupKey, canvasId) {
    if (!window.confirm("Delete this canvas?")) return;

    try {
      await fetch(`/api/canvases/${canvasId}?userId=${userId}`, {
        method: "DELETE"
      });

      const updatedList = (canvases[groupKey] || []).filter(
        (c) => c.id !== canvasId
      );

      setCanvases((prev) => ({
        ...prev,
        [groupKey]: updatedList
      }));

      if (selectedCanvasId === canvasId) {
        setSelectedCanvasId(null);
        mirror.publish({ type: "CANVAS_CHANGED", canvas: null });
      }
    } catch (error) {
      console.error("Canvas Delete Failed", error);
    }
  }

  return (
    <ProjectSidebar
      user={user}
      projects={projects}
      selectedProjectId={selectedProjectId}
      canvases={canvases}
      selectedCanvasId={selectedCanvasId}
      onProjectSelected={selectProject}
      onCreateProject={createProject}
      onRenameProject={renameProject}
      onDeleteProject={deleteProject}
      onCanvasSelected={selectCanvas}
      onCreateCanvas={createCanvas}
      onRenameCanvas={renameCanvas}
      onDeleteCanvas={deleteCanvas}
    />
  );
}

export default FEAMain;
