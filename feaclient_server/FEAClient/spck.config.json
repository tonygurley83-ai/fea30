{
  "run": {
    "type": "url",
    "tasks": {
      "if": [
        [
          "!exists",
          "node_modules"
        ]
      ],
      "then": [
        "npm/install-dep",
        "npm/start"
      ],
      "else": {
        "if": [
          [
            "!urlExists",
            "http://localhost:6700"
          ]
        ],
        "then": "npm/start"
      }
    },
    "url": "http://localhost:6700",
    "ignoreCurrent": true
  }
}