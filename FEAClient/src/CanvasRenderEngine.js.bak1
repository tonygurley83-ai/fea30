import React from "react";

import {
  Layer
} from "react-konva";

import TruncatedOctaGrid
from "../../src/grid/TruncatedOctaGrid";

function CanvasRenderEngine({
  width,
  height,
  nodes,
  gridSize,
  gridVisible,
  renderNode
}) {
  return (
    <>
      <Layer listening={false}>
        <TruncatedOctaGrid
          width={width}
          height={height}
          cellSize={gridSize}
          visible={gridVisible}
        />
      </Layer>

      <Layer>
        {nodes.map(renderNode)}
      </Layer>
    </>
  );
}

export default React.memo(
  CanvasRenderEngine
);
