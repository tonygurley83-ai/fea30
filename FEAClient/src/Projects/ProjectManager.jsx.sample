useEffect(() => {

  async function loadProject() {

    try {

      const response =
        await fetch(
          "/api/projects/1"
        );

      const data =
        await response.json();

      setProject(data);

    }
    catch(error) {

      console.error(
        "Failed to load project",
        error
      );

    }

  }

  loadProject();

}, []);
