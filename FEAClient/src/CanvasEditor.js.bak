import React from "react";
import UnifiedToolbar from "./UnifiedToolbar";
import CanvasManager from "./Canvas/CanvasManager";

export default function CanvasEditor({
  canvas,
  tool,
  setTool,
  gridVisible,
  snapEnabled,
  meshType,
  setMeshType,
  toggleGrid,
  toggleSnap,
  handleUndo,
  handleRedo,
  handleCopy,
  handlePaste,
  handleSave,
  handleLoad,
  handleArchive,
  handleLoadArchive,
  handleConnectAll,
  handleGeneratePolygons,
  ...rest
}) {
  return (
    <div style={{ display: "flex", flexDirection: "column", height: "100vh", width: "100%" }}>
      <UnifiedToolbar
        canvas={canvas}
        tool={tool}
        setTool={setTool}
        gridVisible={gridVisible}
        snapEnabled={snapEnabled}
        meshType={meshType}
        setMeshType={setMeshType}
        onToggleGrid={toggleGrid}
        onToggleSnap={toggleSnap}
        onUndo={handleUndo}
        onRedo={handleRedo}
        onCopy={handleCopy}
        onPaste={handlePaste}
        onSave={handleSave}
        onLoad={handleLoad}
        onArchive={handleArchive}
        onLoadArchive={handleLoadArchive}
        onConnectAll={handleConnectAll}
        onGeneratePolygons={handleGeneratePolygons}
      />
      <div style={{ flex: 1, position: "relative", overflow: "hidden" }}>
        <CanvasManager
          canvas={canvas}
          tool={tool}
          setTool={setTool}
          gridVisible={gridVisible}
          snapEnabled={snapEnabled}
          meshType={meshType}
          {...rest}
        />
      </div>
    </div>
  );
}
