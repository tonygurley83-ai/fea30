const db =
  require("../egg/postgres");

async function create(
  userId,
  data
) {

  const result =
    await db.execute(
      "spCanvas_Create",
      {
        UserId: userId,
        Name: data.name,
        CanvasData:
          JSON.stringify(
            data.canvasData
          )
      }
    );

  return result[0];

}

async function update(
  userId,
  canvas_id,
  data
) {

  const result =
    await db.execute(
      "spCanvas_Update",
      {
        UserId: userId,
        CanvasId: canvas_id,
        Name: data.name,
        CanvasData:
          JSON.stringify(
            data.canvasData
          )
      }
    );

  return result[0];

}

async function share(
  userId,
  canvas_id,
  projectIds
) {

  return db.execute(
    "spCanvas_Share",
    {
      UserId: userId,
      CanvasId: canvas_id,
      ProjectIds:
        JSON.stringify(
          projectIds
        )
    }
  );

}

async function remove(
  userId,
  canvas_id
) {

  return db.execute(
    "spCanvas_Delete",
    {
      UserId: userId,
      CanvasId: canvas_id
    }
  );

}

module.exports = {
  create,
  update,
  share,
  delete: remove
};

