const repository =
  require(
    "../repositories/CanvasRepository"
  );

async function createCanvas(
  userId,
  data
) {

  if (!data.name?.trim()) {

    throw new Error(
      "Canvas name required"
    );

  }

  return repository.create(
    userId,
    {
      ...data,
      name: data.name.trim()
    }
  );

}

async function updateCanvas(
  userId,
  canvas_id,
  data
) {

  if (
    data.name !== undefined &&
    !data.name.trim()
  ) {

    throw new Error(
      "Canvas name required"
    );

  }

  return repository.update(
    userId,
    canvas_id,
    {
      ...data,
      name:
        data.name?.trim()
    }
  );

}

async function shareCanvas(
  userId,
  canvas_id,
  projectIds
) {

  return repository.share(
    userId,
    canvas_id,
    projectIds
  );

}

async function deleteCanvas(
  userId,
  canvas_id
) {

  return repository.delete(
    userId,
    canvas_id
  );

}

module.exports = {
  createCanvas,
  updateCanvas,
  shareCanvas,
  deleteCanvas
};
