/*
 * CURRENT LOGGED-IN USER
 */

router.get(
  "/auth/me",
  requireAuth,
  async (req, res) => {

    try {

      const userId =
        req.user?.userId ||
        req.user?.id;

      const user =
        await AuthService.getUser(
          userId
        );

      if (!user) {

        return res
          .status(404)
          .json({
            error:
              "User not found"
          });

      }

      res.json(user);

    }
    catch (err) {

      res.status(500).json({
        error:
          err.message
      });

    }

  }
);

