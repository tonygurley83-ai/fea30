    "@babel/preset-react": "^7.29.7",
    "@hot-loader/react-dom": "17.0.1",
    "babel-loader": "^9.2.1",
    "concurrently": "^10.0.4",
    "react-konva": "^19.2.5",
    "webpack": "^5.109.2",
    "webpack-cli": "5.1.4",
    "webpack-dev-server": "^6.0.0"
  }
}
