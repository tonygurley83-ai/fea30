  "scripts": {
    "clean": "rm dist/bundle.js",
    "install-dep": "npm i --no-bin-links",
    "build": "webpack",
    "build-prod": "webpack --mode production",
    "start": "npm install --save-dev @babel/core@7.26.0 @babel/preset-env @babel/preset-react babel-loader --legacy-peer-deps && webpack-dev-server"
  },
  "dependencies": {
    "axios": "^1.13.2",
