import eruda from "eruda";

eruda.init();
eruda.show();

import React from "react";
import ReactDOM from "react-dom";

import MasterManager from "./MasterManager";
import LoginSuccess from "./LoginSuccess";

const path =
  window.location.pathname;

if (
  path ===
  "/login-success"
) {

  ReactDOM.render(

    <LoginSuccess />,

    document.getElementById(
      "root"
    )

  );

}
else {

  ReactDOM.render(

    <MasterManager />,

    document.getElementById(
      "root"
    )

  );

}
